# FurniAI Environment Variables
# Copy this file to .env.local and fill in real values before running locally.
# On Vercel: add these in the Project → Settings → Environment Variables panel.

# ── AI providers (Anthropic + OpenAI, with automatic failover) ─────────────
# Used by /api/sales-agent, /api/wardrobe/chat, and /api/v1/furniture/generate.
# At least one of ANTHROPIC_API_KEY / OPENAI_API_KEY must be set; FurniAI
# operates on whichever one(s) are configured. Get an Anthropic key at
# https://console.anthropic.com and an OpenAI key at https://platform.openai.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Which provider to try first, then fall back to on a provider-level problem
# (missing/invalid key, rate limit, quota, timeout, transient server error) —
# never on a FurniAI validation/tool error. Comma-separated, e.g.
# "anthropic,openai" (default) or "openai,anthropic". Change this in Vercel's
# environment variables to change priority without a code deploy.
AI_PROVIDER_ORDER=anthropic,openai

# Set to "true" to include a safe {provider, fallback} debug field on
# /api/wardrobe/chat and /api/sales-agent responses in production (normally
# only shown when NODE_ENV !== "production"). Never exposes keys or raw
# provider payloads.
FURNIAI_FOUNDER_PREVIEW=

# Production-pack authentication. These are the public project URL and anon
# key used to validate the signed-in user's access token server-side.
SUPABASE_URL=
SUPABASE_ANON_KEY=
FURNIAI_ALLOWED_ORIGINS=https://furnia.vercel.app

# ── WhatsApp Cloud API (optional) ───────────────────────────────────────────
# Required only if you enable /api/whatsapp webhook integration.
# Provision credentials at https://developers.facebook.com/apps
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ── Scenario (AI visual concepts: reference image → 3D) ─────────────────────
# Server-side only. Never expose these to the browser or commit real values.
# Used by /api/creative. See docs/creative/SCENARIO_3D_API_CONTRACT.md.
SCENARIO_API_KEY=
SCENARIO_API_SECRET=
# The values below have NO defaults on purpose. Set them from what
# `npm run scenario:discover` reports for this account.
SCENARIO_3D_MODEL_ID=
# Name of the chosen model's reference-image input, and whether it takes a list.
SCENARIO_3D_IMAGE_PARAM=
SCENARIO_3D_IMAGE_PARAM_IS_ARRAY=
# Optional extra model inputs as a JSON object.
SCENARIO_3D_EXTRA_PARAMS_JSON=
# Provider job-status words that mean finished / failed (comma-separated).
SCENARIO_STATUS_SUCCESS=
SCENARIO_STATUS_FAILURE=
# Set to "yes" if POST /assets needs a data: URL rather than raw base64.
SCENARIO_ASSET_UPLOAD_DATA_URL=
# Spend controls. Generation is refused unless BOTH are set: the switch must be
# exactly "yes", and the provider's cost preview must not exceed the cap.
SCENARIO_LIVE_GENERATION_ENABLED=
SCENARIO_MAX_COST_PER_JOB=
# ≥32 random characters; signs stored generation records (required when deployed).
CREATIVE_RECORD_SIGNING_KEY=
