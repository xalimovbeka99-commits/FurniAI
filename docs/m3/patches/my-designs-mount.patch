+/* ===== My Designs (durable /api/designs) — module: src/lib/designs/myDesigns, bundle: /my-designs.js ===== */
+/* Lists the signed-in customer's server-saved designs and hands the chosen one to the Studio.
+   The designs client is Antigravity's createDesignsApiClient (src/lib/persistence/designsApiClient.js),
+   expected on window.FurniDesignsApi; the reopen is Antigravity's window.reopenDesignFromApi.
+   If either bundle is absent the panel stays hidden and the legacy grid below is unchanged. */
+let myDesignsHandle=null;
+async function myDesignsAccessToken(){
+  if(!sb)return null;
+  try{const {data}=await sb.auth.getSession();return (data&&data.session&&data.session.access_token)||null}
+  catch(e){return null}
+}
+function mountMyDesignsPanel(){
+  const root=document.getElementById('myDesignsRoot');
+  if(!root)return;
+  if(myDesignsHandle){myDesignsHandle.refresh();return}
+  const lib=window.FurniMyDesigns, api=window.FurniDesignsApi;
+  if(!lib||typeof lib.mountMyDesigns!=='function'||!api||typeof api.createDesignsApiClient!=='function'){root.hidden=true;return}
+  root.hidden=false;
+  myDesignsHandle=lib.mountMyDesigns(root,{
+    client:api.createDesignsApiClient({getAccessToken:myDesignsAccessToken}),
+    getAccessToken:myDesignsAccessToken,
+    onSignIn:openAuthModal,
+    // selection = {designId, revision, name}, all read from the server; record = the reopen body.
+    onOpenDesign:function(selection,record){
+      if(typeof window.reopenDesignFromApi!=='function')throw new Error('reopenDesignFromApi is not available');
+      return window.reopenDesignFromApi(selection,record);
+    }
+  });
+}
+
 /* ===== boot ===== */
 function boot(){
   heroInit();
