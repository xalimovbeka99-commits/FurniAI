{
  "cleanUrls": true,
  "framework": null,
  "buildCommand": "mkdir -p dist && cp index.html styles.css app.js legacy-builder-adapter.js vendor-three-r128.min.js vendor-supabase.min.js dist/",
  "outputDirectory": "dist",
  "functions": {
    "api/production.py": {
      "maxDuration": 60,
      "includeFiles": "production-engine/furniai_engine/**",
      "excludeFiles": "{production-engine/**/output/**,production-engine/**/out*/**,production-engine/**/jobs/**,production-engine/**/test*.py,production-engine/**/run_all_harnesses.py}"
    }
  }
}
